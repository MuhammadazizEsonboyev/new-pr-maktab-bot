# =====================================================================
#  Nusxa oling:  cp .env.example .env   — va qiymatlarni to'ldiring.
#  .env HECH QACHON gitga/arxivga qo'shilmasin (unda maxfiy kalitlar bor).
# =====================================================================

# ---------- Frontend (build vaqtida kodga qo'shiladi, ommaviy) ----------
VITE_BOT_USERNAME=prezidentschool_bot
# Ixtiyoriy. Bo'sh bo'lsa: /api (Vercel). Supabase Edge Function ishlatsangiz:
# VITE_API_URL=https://xxxx.supabase.co/functions/v1/api

# ---------- Server API + bot (MAXFIY) ----------
BOT_TOKEN=123456:ABC...                 # @BotFather dan
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # Settings → API → service_role (yoki sb_secret_...)
ALLOWED_CREATOR_IDS=8204982447           # test yarata oladiganlar, vergul bilan: 111,222
WEBAPP_URL=https://pr-bot-mini-app.vercel.app
# NOTIFY_OWNER=0                         # ustozga natija xabarini o'chirish

# ---------- Faqat lokal sinov (npm run dev) ----------
# Oddiy brauzerda shu ID nomidan kirish (Telegramsiz sinash uchun):
# DEV_USER_ID=8204982447
# DEV_USER_NAME=Ustoz
