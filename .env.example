# VITE_API_URL=https://xxxx.supabase.co/functions/v1/api

# ---------- Server API + bot (MAXFIY) ----------
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_CREATOR_IDS=
WEBAPP_URL=
